# ==============================================================================
# farmTrace - Master .gitignore
# STRICT SECURITY: Ensure NO credentials or environment files are tracked!
# ==============================================================================

# Environment files & Secrets
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env
id.txt
*.pem
*.key
*.cert

# Dependencies
node_modules/
*/node_modules/

# Production Build outputs
dist/
dist-ssr/
build/
*/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
