# ==============================================================================
# farmTrace Backend Environment Variables Template
# Copy this file to .env and fill in your actual Supabase credentials
# NEVER COMMIT THE ACTUAL .env FILE TO GITHUB!
# ==============================================================================

PORT=5000
NODE_ENV=development

# Required application secret used for JWT signing.
# MUST be set in your real backend .env file and kept out of source control.
JWT_SECRET=replace-with-long-random-secret

# Supabase Project Credentials (from your Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Client Application URL
FRONTEND_URL=http://localhost:5173
