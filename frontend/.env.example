# ==============================================================================
# farmTrace Frontend Environment Variables Template
# Copy this file to .env and fill in your actual Supabase credentials
# NEVER COMMIT THE ACTUAL .env FILE TO GITHUB!
# ==============================================================================

# Supabase Project Credentials (from your Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL (Optional if using direct Supabase queries)
VITE_API_URL=http://localhost:5000/api
